{
  "$schema": "http://json.schemastore.org/template",
  "author": "Antigravity",
  "classifications": [ "Web", "API", "Clean Architecture" ],
  "name": "Clean Architecture .NET 10 Web API Template",
  "generatorVersions": "[1.0.0.0-*)",
  "description": "Production-ready Clean Architecture .NET 10 Web API template with JWT authentication, EF Core (SQL Server / PostgreSQL), FluentValidation, Serilog, and OpenAPI.",
  "identity": "WeApi.Template",
  "shortName": "we-api",
  "defaultName": "WeSpace.Api",
  "sourceName": "WeSpace.Api",
  "preferNameDirectory": true,
  "symbols": {
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "sqlserver",
          "description": "Microsoft SQL Server database provider with EF Core"
        },
        {
          "choice": "postgresql",
          "description": "PostgreSQL database provider with EF Core (Npgsql)"
        }
      ],
      "defaultValue": "sqlserver",
      "description": "The relational database provider to configure by default."
    },
    "idType": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "guid",
          "description": "GUID / UUID v7 identifier (recommended for distributed systems and clean separation)"
        },
        {
          "choice": "int",
          "description": "32-bit auto-incrementing integer identity"
        },
        {
          "choice": "long",
          "description": "64-bit auto-incrementing bigint identity (suitable for high scale)"
        }
      ],
      "defaultValue": "guid",
      "description": "The primary key identifier type to use for domain entities."
    },
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": ".NET 10.0 (Latest)"
        },
        {
          "choice": "net9.0",
          "description": ".NET 9.0"
        },
        {
          "choice": "net8.0",
          "description": ".NET 8.0 (LTS)"
        },
        {
          "choice": "net7.0",
          "description": ".NET 7.0 (STS)"
        },
        {
          "choice": "net6.0",
          "description": ".NET 6.0 (LTS)"
        }
      ],
      "defaultValue": "net10.0",
      "description": "The target .NET framework version for the solution."
    },
    "frameworkReplacement": {
      "type": "generated",
      "generator": "switch",
      "replaces": "<TargetFramework>net10.0</TargetFramework>",
      "parameters": {
        "cases": [
          {
            "condition": "(framework == \"net6.0\")",
            "value": "<TargetFramework>net6.0</TargetFramework>"
          },
          {
            "condition": "(framework == \"net7.0\")",
            "value": "<TargetFramework>net7.0</TargetFramework>"
          },
          {
            "condition": "(framework == \"net8.0\")",
            "value": "<TargetFramework>net8.0</TargetFramework>"
          },
          {
            "condition": "(framework == \"net9.0\")",
            "value": "<TargetFramework>net9.0</TargetFramework>"
          },
          {
            "condition": "(framework == \"net10.0\")",
            "value": "<TargetFramework>net10.0</TargetFramework>"
          }
        ]
      }
    },
    "useIntId": {
      "type": "computed",
      "value": "(idType == \"int\")"
    },
    "useLongId": {
      "type": "computed",
      "value": "(idType == \"long\")"
    },
    "useGuidId": {
      "type": "computed",
      "value": "(idType == \"guid\")"
    },
    "dbProviderReplacement": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"Provider\": \"SqlServer\"",
      "parameters": {
        "cases": [
          {
            "condition": "(database == \"postgresql\")",
            "value": "\"Provider\": \"PostgreSql\""
          },
          {
            "condition": "(database == \"sqlserver\")",
            "value": "\"Provider\": \"SqlServer\""
          }
        ]
      }
    },
    "dbConnectionStringReplacement": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"DefaultConnection\": \"Server=(localdb)\\\\mssqllocaldb;Database=WeSpaceApiDb;Trusted_Connection=True;MultipleActiveResultSets=true\"",
      "parameters": {
        "cases": [
          {
            "condition": "(database == \"postgresql\")",
            "value": "\"DefaultConnection\": \"Host=localhost;Port=5432;Database=WeSpaceApiDb;Username=postgres;Password=postgres\""
          },
          {
            "condition": "(database == \"sqlserver\")",
            "value": "\"DefaultConnection\": \"Server=(localdb)\\\\mssqllocaldb;Database=WeSpaceApiDb;Trusted_Connection=True;MultipleActiveResultSets=true\""
          }
        ]
      }
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/*.user",
            "**/.vs/**",
            "**/.vscode/**",
            "**/.idea/**"
          ]
        }
      ]
    }
  ]
}
