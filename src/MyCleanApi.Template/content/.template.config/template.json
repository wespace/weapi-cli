{
  "$schema": "http://json.schemastore.org/template",
  "author": "Antigravity",
  "classifications": [ "Web", "API", "Clean Architecture" ],
  "name": "Clean Architecture .NET 10 Web API Template",
  "generatorVersions": "[1.0.0.0-*)",
  "description": "Production-ready Clean Architecture .NET 10 Web API template with JWT authentication, EF Core (SQL Server / PostgreSQL), FluentValidation, Serilog, and OpenAPI.",
  "identity": "MyCleanApi.Template",
  "shortName": "my-clean-api",
  "defaultName": "MyCompany.MyApi",
  "sourceName": "MyCompany.MyApi",
  "preferNameDirectory": true,
  "symbols": {
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "sqlserver",
          "description": "Microsoft SQL Server database provider with EF Core"
        },
        {
          "choice": "postgresql",
          "description": "PostgreSQL database provider with EF Core (Npgsql)"
        }
      ],
      "defaultValue": "sqlserver",
      "description": "The relational database provider to configure by default."
    },
    "dbProviderReplacement": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"Provider\": \"SqlServer\"",
      "parameters": {
        "cases": [
          {
            "condition": "(database == \"postgresql\")",
            "value": "\"Provider\": \"PostgreSql\""
          },
          {
            "condition": "(database == \"sqlserver\")",
            "value": "\"Provider\": \"SqlServer\""
          }
        ]
      }
    },
    "dbConnectionStringReplacement": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"DefaultConnection\": \"Server=(localdb)\\\\mssqllocaldb;Database=MyCompanyMyApiDb;Trusted_Connection=True;MultipleActiveResultSets=true\"",
      "parameters": {
        "cases": [
          {
            "condition": "(database == \"postgresql\")",
            "value": "\"DefaultConnection\": \"Host=localhost;Port=5432;Database=MyCompanyMyApiDb;Username=postgres;Password=postgres\""
          },
          {
            "condition": "(database == \"sqlserver\")",
            "value": "\"DefaultConnection\": \"Server=(localdb)\\\\mssqllocaldb;Database=MyCompanyMyApiDb;Trusted_Connection=True;MultipleActiveResultSets=true\""
          }
        ]
      }
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/*.user",
            "**/.vs/**",
            "**/.vscode/**",
            "**/.idea/**"
          ]
        }
      ]
    }
  ]
}
