<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>MyCleanApi.Template</PackageId>
    <Title>Clean Architecture .NET 10 Web API Template</Title>
    <Version>1.0.0</Version>
    <Authors>MyCleanApi Contributors</Authors>
    <Company>MyCleanApi</Company>
    <Product>MyCleanApi</Product>
    <Description>Production-ready Clean Architecture .NET 10 Web API template with JWT authentication, EF Core (SQL Server / PostgreSQL), FluentValidation, Serilog, and OpenAPI.</Description>
    <PackageTags>dotnet-new;templates;clean-architecture;webapi;dotnet10;jwt;efcore;csharp;postgresql;sqlserver</PackageTags>
    <PackageProjectUrl>https://github.com/mycleanapi/dotnet-clean-api</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mycleanapi/dotnet-clean-api</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
